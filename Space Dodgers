import pygame
import random
import math
import json
import os
from enum import Enum
import serial

# Initialize Pygame
pygame.init()
pygame.mixer.init()

# Screen dimensions
SCREEN_WIDTH = 1000
SCREEN_HEIGHT = 700

# Colors
BLACK = (0, 0, 0)
WHITE = (255, 255, 255)
GREEN = (0, 255, 0)
RED = (255, 0, 0)
YELLOW = (255, 255, 0)
CYAN = (0, 255, 255)

# Game settings
FPS = 60
ASTEROID_SPAWN_RATE = 0.02
ASTEROID_MAX = 15

# High score file
HIGH_SCORE_FILE = "highscore.json"


def load_shoot_sound():
    """Load laser sound from MP3 file, fallback to generated sound if file not found"""
    sound_file = "laser.mp3"  # Change this to your MP3 filename
    
    if os.path.exists(sound_file):
        try:
            sound = pygame.mixer.Sound(sound_file)
            print(f"Loaded laser sound from {sound_file}")
            return sound
        except Exception as e:
            print(f"Could not load {sound_file}: {e}")
            print("Falling back to generated sound...")
            return create_shoot_sound()
    else:
        print(f"File {sound_file} not found. Using generated sound.")
        return create_shoot_sound()


def create_shoot_sound():
    """Generate a futuristic laser blast with echo effect (fallback)"""
    sample_rate = 22050
    duration = 0.35  # Longer for echo effect
    num_samples = int(sample_rate * duration)
    
    # Create mono sound data
    frames = bytearray()
    
    # Generate the initial laser sound
    laser_samples = []
    for i in range(num_samples):
        progress = i / num_samples
        
        # Futuristic laser: complex frequency sweep
        # Primary frequency with pitch bend
        if progress < 0.2:
            primary_freq = 120 + (480 * (progress / 0.2))  # Rise from 120Hz to 600Hz
        elif progress < 0.4:
            primary_freq = 600 - (200 * ((progress - 0.2) / 0.2))  # Dip to 400Hz
        else:
            primary_freq = 400 - (350 * ((progress - 0.4) / 0.6))  # Fall to 50Hz
        
        # Create futuristic tone with many harmonics and detuning
        wave = 0.5 * math.sin(2 * math.pi * primary_freq * i / sample_rate)
        wave += 0.3 * math.sin(2 * math.pi * (primary_freq * 1.3) * i / sample_rate)
        wave += 0.25 * math.sin(2 * math.pi * (primary_freq * 1.98) * i / sample_rate)
        wave += 0.2 * math.sin(2 * math.pi * (primary_freq * 2.7) * i / sample_rate)
        wave += 0.15 * math.sin(2 * math.pi * (primary_freq * 3.4) * i / sample_rate)
        wave += 0.1 * math.sin(2 * math.pi * (primary_freq * 4.1) * i / sample_rate)
        
        # Add sub-bass for power
        wave += 0.3 * math.sin(2 * math.pi * 70 * i / sample_rate)
        
        # Add a high frequency shimmer for futuristic feel
        wave += 0.15 * math.sin(2 * math.pi * (primary_freq * 6.5) * i / sample_rate)
        
        # Envelope: attack, sustain, decay
        if progress < 0.08:
            envelope = progress * 12.5
        elif progress < 0.6:
            envelope = 1.0
        else:
            envelope = 1 - ((progress - 0.6) / 0.4)
        
        sample_value = 0.45 * envelope * wave
        laser_samples.append(sample_value)
    
    # Add echo/reverb effect by mixing in delayed copies
    echo_delay_1 = int(0.08 * sample_rate)  # 80ms echo
    echo_delay_2 = int(0.15 * sample_rate)  # 150ms echo
    echo_decay = 0.4  # How much quieter the echoes are
    
    for i in range(num_samples):
        sample = laser_samples[i]
        
        # Add first echo
        if i >= echo_delay_1:
            sample += laser_samples[i - echo_delay_1] * echo_decay
        
        # Add second echo
        if i >= echo_delay_2:
            sample += laser_samples[i - echo_delay_2] * echo_decay * 0.6
        
        # Clamp to prevent clipping
        sample = max(-1, min(1, sample))
        
        sample_bytes = int(sample * 32767).to_bytes(2, byteorder='little', signed=True)
        frames.extend(sample_bytes)
    
    # Create Sound from raw audio data
    sound = pygame.mixer.Sound(buffer=frames)
    return sound


class GameState(Enum):
    MENU = 1
    PLAYING = 2
    GAME_OVER = 3


class Player(pygame.sprite.Sprite):
    """Player spaceship"""
    
    def __init__(self, x, y):
        super().__init__()
        self.x = x
        self.y = y
        self.angle = 0  # 0 degrees points up
        self.size = 15
        self.speed = 6
        self.rotation_speed = 6
        self.vel_x = 0
        self.vel_y = 0
        self.image = self._create_image()
        self.rect = self.image.get_rect(center=(self.x, self.y))
        self.health = 3
        
    def _create_image(self):
        """Create a detailed triangle-shaped spaceship with clear front"""
        size = self.size
        surface = pygame.Surface((size * 3, size * 3), pygame.SRCALPHA)
        center = size * 1.5
        
        # Main body (green triangle)
        points = [
            (center, center - size),  # tip (front)
            (center + size, center + size),  # bottom right
            (center - size, center + size)   # bottom left
        ]
        pygame.draw.polygon(surface, GREEN, points)
        pygame.draw.polygon(surface, WHITE, points, 2)  # outline
        
        # Bright yellow tip to show front clearly
        pygame.draw.circle(surface, YELLOW, (int(center), int(center - size)), 3)
        
        # Engine flame (red) at the back when accelerating
        pygame.draw.polygon(surface, RED, [
            (center, center + size),
            (center - size * 0.6, center + size + size * 0.8),
            (center + size * 0.6, center + size + size * 0.8)
        ])
        
        return surface
    
    def get_tip_position(self):
        """Calculate the world position of the ship's front tip"""
        rad = math.radians(270 - self.angle)
        # Offset from center to tip (approximately self.size units forward)
        tip_x = self.x + math.cos(rad) * self.size
        tip_y = self.y + math.sin(rad) * self.size
        return tip_x, tip_y
    
    def handle_input(self, keys):
        """Handle player input - move in the direction the arrow points"""
        self.vel_x = 0
        self.vel_y = 0
        
        # Rotate
        if keys[pygame.K_LEFT]:
            self.angle += self.rotation_speed
        if keys[pygame.K_RIGHT]:
            self.angle -= self.rotation_speed
        
        # Move in the direction the arrow is pointing
        rad = math.radians(270 - self.angle)
        if keys[pygame.K_UP]:
            self.vel_x = math.cos(rad) * self.speed
            self.vel_y = math.sin(rad) * self.speed
        elif keys[pygame.K_DOWN]:
            self.vel_x = -math.cos(rad) * self.speed
            self.vel_y = -math.sin(rad) * self.speed
    
    def update(self):
        """Update player position"""
        self.x += self.vel_x
        self.y += self.vel_y
        
        # Keep player within screen boundaries
        if self.x < self.size:
            self.x = self.size
        if self.x > SCREEN_WIDTH - self.size:
            self.x = SCREEN_WIDTH - self.size
        if self.y < self.size:
            self.y = self.size
        if self.y > SCREEN_HEIGHT - self.size:
            self.y = SCREEN_HEIGHT - self.size
        
        # Rotate sprite
        rotated_image = pygame.transform.rotate(self._create_image(), self.angle)
        self.image = rotated_image
        self.rect = self.image.get_rect(center=(self.x, self.y))
    
    def shoot(self):
        """Create a bullet from the tip of the ship in the direction the arrow points"""
        tip_x, tip_y = self.get_tip_position()
        rad = math.radians(270 - self.angle)
        
        # Bullet travels in the direction the arrow is pointing
        bullet_speed = 8
        bullet_vel_x = math.cos(rad) * bullet_speed
        bullet_vel_y = math.sin(rad) * bullet_speed
        
        return Bullet(tip_x, tip_y, bullet_vel_x, bullet_vel_y)
    
    def take_damage(self):
        """Reduce health"""
        self.health -= 1


class Bullet(pygame.sprite.Sprite):
    """Player bullet"""
    
    def __init__(self, x, y, vel_x, vel_y):
        super().__init__()
        self.x = x
        self.y = y
        self.vel_x = vel_x
        self.vel_y = vel_y
        self.image = pygame.Surface((4, 4))
        self.image.fill(YELLOW)
        self.rect = self.image.get_rect(center=(self.x, self.y))
        self.lifetime = 300  # frames
    
    def update(self):
        """Update bullet position"""
        self.x += self.vel_x
        self.y += self.vel_y
        self.lifetime -= 1
        
        self.rect.center = (self.x, self.y)
        
        # Remove if off screen or lifetime expired
        if (self.x < 0 or self.x > SCREEN_WIDTH or 
            self.y < 0 or self.y > SCREEN_HEIGHT or 
            self.lifetime <= 0):
            self.kill()


class Asteroid(pygame.sprite.Sprite):
    """Asteroid that player must avoid/destroy"""
    
    def __init__(self, x, y, size=3):
        super().__init__()
        self.x = x
        self.y = y
        self.size = size  # 1=small, 2=medium, 3=large
        self.radius = size * 10
        self.vel_x = random.uniform(-2, 2)
        self.vel_y = random.uniform(-2, 2)
        self.rotation = 0
        self.rotation_speed = random.uniform(-5, 5)
        self.speed_multiplier = 1.0  # Difficulty scaling
        self._create_image()
    
    def set_speed_multiplier(self, multiplier):
        """Set the speed multiplier for difficulty scaling"""
        self.speed_multiplier = multiplier
    
    def _create_image(self):
        """Create asteroid image"""
        self.image = pygame.Surface((self.radius * 2, self.radius * 2), pygame.SRCALPHA)
        pygame.draw.circle(self.image, WHITE, (self.radius, self.radius), self.radius, 2)
        self.rect = self.image.get_rect(center=(self.x, self.y))
    
    def update(self):
        """Update asteroid position"""
        self.x += self.vel_x * self.speed_multiplier
        self.y += self.vel_y * self.speed_multiplier
        self.rotation += self.rotation_speed
        
        # Wrap around screen
        if self.x < -self.radius:
            self.x = SCREEN_WIDTH + self.radius
        if self.x > SCREEN_WIDTH + self.radius:
            self.x = -self.radius
        if self.y < -self.radius:
            self.y = SCREEN_HEIGHT + self.radius
        if self.y > SCREEN_HEIGHT + self.radius:
            self.y = -self.radius
        
        self.rect.center = (self.x, self.y)
    
    def split(self):
        """Return smaller asteroids when destroyed"""
        if self.size > 1:
            new_asteroids = []
            for _ in range(2):
                new_x = self.x + random.uniform(-20, 20)
                new_y = self.y + random.uniform(-20, 20)
                new_ast = Asteroid(new_x, new_y, self.size - 1)
                new_ast.set_speed_multiplier(self.speed_multiplier)
                new_asteroids.append(new_ast)
            return new_asteroids
        return []


class Game:
    """Main game class"""
    
    def __init__(self):
        self.screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
        pygame.display.set_caption("Space Dodgers")
        self.clock = pygame.time.Clock()

        self.ser = serial.Serial('COM5', 9600, timeout=0)  # Update 'COM5' to your Arduino's port

        self.joy_forward = False
        self.joy_backward = False
        self.joy_left = False
        self.joy_right = False
        self.joy_shoot = False

        
        self.font_large = pygame.font.Font(None, 72)
        self.font_medium = pygame.font.Font(None, 48)
        self.font_small = pygame.font.Font(None, 36)
        self.font_tiny = pygame.font.Font(None, 24)

        
        # Load sounds
        self.shoot_sound = load_shoot_sound()
        
        self.state = GameState.MENU
        self.reset_game()
        self.load_high_score()

    def read_joystick(self):
        line = self.ser.readline().decode(errors='ignore').strip()
        if not line:
            return 0, 0, 0

        parts = line.split(',')
        if len(parts) != 3:
            return 0, 0, 0

        try:
            joy_x, joy_y, button = map(int, parts)
            return joy_x, joy_y, button
        except:
             return 0, 0, 0

    
    def reset_game(self):
        """Reset game variables"""
        self.player = Player(SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2)
        self.bullets = pygame.sprite.Group()
        self.asteroids = pygame.sprite.Group()
        self.score = 0
        self.time_elapsed = 0
        self.spawn_timer = 0
        self.invulnerable_timer = 120  # frames of invulnerability
        self.shoot_cooldown = 0
        self.speed_multiplier = 1.0  # Difficulty scaling
        self.last_speed_increase = 0  # Track time of last speed increase
        
        # Spawn initial asteroids
        for _ in range(3):
            x = random.randint(0, SCREEN_WIDTH)
            y = random.randint(0, SCREEN_HEIGHT)
            # Make sure they don't spawn on player
            while abs(x - self.player.x) < 100 and abs(y - self.player.y) < 100:
                x = random.randint(0, SCREEN_WIDTH)
                y = random.randint(0, SCREEN_HEIGHT)
            new_asteroid = Asteroid(x, y)
            new_asteroid.set_speed_multiplier(self.speed_multiplier)
            self.asteroids.add(new_asteroid)
    
    def load_high_score(self):
        """Load high score from file"""
        if os.path.exists(HIGH_SCORE_FILE):
            try:
                with open(HIGH_SCORE_FILE, 'r') as f:
                    data = json.load(f)
                    self.high_score = data.get('high_score', 0)
            except:
                self.high_score = 0
        else:
            self.high_score = 0
    
    def save_high_score(self):
        """Save high score to file"""
        with open(HIGH_SCORE_FILE, 'w') as f:
            json.dump({'high_score': self.high_score}, f)
    
    def handle_events(self):
        """Handle events"""
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                return False
            
            if event.type == pygame.KEYDOWN:
                if self.state == GameState.MENU:
                    if event.key == pygame.K_SPACE:
                        self.state = GameState.PLAYING
                elif self.state == GameState.PLAYING:
                    if event.key == pygame.K_SPACE:
                        if self.shoot_cooldown <= 0:
                            self.bullets.add(self.player.shoot())
                            self.shoot_sound.play()
                            self.shoot_cooldown = 10
                elif self.state == GameState.GAME_OVER:
                    if event.key == pygame.K_SPACE:
                        self.state = GameState.MENU
                        self.reset_game()
                    if event.key == pygame.K_q:
                        return False
        
        return True
    
    def update(self):
        """Update game state"""
        if self.state != GameState.PLAYING:
            return
        
        # Update timers
        self.time_elapsed += 1 / FPS
        self.invulnerable_timer -= 1
        self.shoot_cooldown -= 1
        
        # Check for difficulty increase every 30 seconds
        if self.time_elapsed - self.last_speed_increase >= 30:
            self.speed_multiplier *= 1.5
            self.last_speed_increase = self.time_elapsed
            # Apply new speed multiplier to all asteroids
            for asteroid in self.asteroids:
                asteroid.set_speed_multiplier(self.speed_multiplier)
        
        joy_x, joy_y, button = self.read_joystick()
        # --- JOYSTICK ROTATION ---
        deadzone = 100

        if -joy_x < -deadzone:
            self.player.angle += self.player.rotation_speed
        elif -joy_x > deadzone:
            self.player.angle -= self.player.rotation_speed

        # --- JOYSTICK MOVEMENT (smooth, continuous) ---
        rad = math.radians(270 - self.player.angle)

        self.player.vel_x = 0
        self.player.vel_y = 0

        if -joy_y < -deadzone:  # backward
            self.player.vel_x = math.cos(rad) * self.player.speed
            self.player.vel_y = math.sin(rad) * self.player.speed
        elif -joy_y > deadzone:  # forward
            self.player.vel_x = -math.cos(rad) * self.player.speed
            self.player.vel_y = -math.sin(rad) * self.player.speed

        # --- SHOOT ---
        if button == 1 and self.shoot_cooldown <= 0:
            self.bullets.add(self.player.shoot())
            self.shoot_sound.play()
            self.shoot_cooldown = 10



        # Auto-spawn asteroids
        self.spawn_timer += 1
        if (self.spawn_timer > 30 and 
            len(self.asteroids) < ASTEROID_MAX and 
            random.random() < ASTEROID_SPAWN_RATE):
            x = random.choice([random.randint(0, 50), random.randint(SCREEN_WIDTH - 50, SCREEN_WIDTH)])
            y = random.randint(0, SCREEN_HEIGHT)
            new_asteroid = Asteroid(x, y)
            new_asteroid.set_speed_multiplier(self.speed_multiplier)
            self.asteroids.add(new_asteroid)
            self.spawn_timer = 0
        
        # Update sprites
        self.player.update()
        self.bullets.update()
        self.asteroids.update()
        
        # Check bullet-asteroid collisions
        for bullet in self.bullets:
            for asteroid in self.asteroids:
                if pygame.sprite.spritecollide(bullet, pygame.sprite.Group(asteroid), False):
                    # Points based on asteroid size (smaller = more points)
                    points = (4 - asteroid.size) * 50
                    self.score += points
                    
                    bullet.kill()
                    new_asteroids = asteroid.split()
                    asteroid.kill()
                    for new_ast in new_asteroids:
                        self.asteroids.add(new_ast)
                    break
        
        # Check player-asteroid collisions
        if self.invulnerable_timer <= 0:
            for asteroid in self.asteroids:
                distance = math.sqrt((self.player.x - asteroid.x) ** 2 + 
                                   (self.player.y - asteroid.y) ** 2)
                if distance < self.player.size + asteroid.radius:
                    self.player.take_damage()
                    self.invulnerable_timer = 120
                    if self.player.health <= 0:
                        self.state = GameState.GAME_OVER
                        if self.score > self.high_score:
                            self.high_score = self.score
                            self.save_high_score()
                    break
    
    def draw(self):
        """Draw everything"""
        self.screen.fill(BLACK)
        
        if self.state == GameState.MENU:
            self.draw_menu()
        elif self.state == GameState.PLAYING:
            self.draw_game()
        elif self.state == GameState.GAME_OVER:
            self.draw_game_over()
    
    def draw_menu(self):
        """Draw main menu"""
        title = self.font_large.render("SPACE DODGERS", True, GREEN)
        start = self.font_medium.render("Press SPACE to Start", True, CYAN)
        controls = self.font_small.render("Arrow Keys: Rotate | Up/Down: Move | SPACE: Shoot", True, WHITE)
        objective = self.font_small.render("Dodge and destroy asteroids!", True, YELLOW)
        
        self.screen.blit(title, (SCREEN_WIDTH // 2 - title.get_width() // 2, 100))
        self.screen.blit(start, (SCREEN_WIDTH // 2 - start.get_width() // 2, 250))
        self.screen.blit(controls, (SCREEN_WIDTH // 2 - controls.get_width() // 2, 350))
        self.screen.blit(objective, (SCREEN_WIDTH // 2 - objective.get_width() // 2, 420))
        
        high_score_text = self.font_small.render(f"High Score: {self.high_score}", True, RED)
        self.screen.blit(high_score_text, (SCREEN_WIDTH // 2 - high_score_text.get_width() // 2, 550))
    
    def draw_game(self):
        """Draw game screen"""
        # Draw sprites
        self.bullets.draw(self.screen)
        self.asteroids.draw(self.screen)
        
        # Draw player (with flashing if invulnerable)
        if self.invulnerable_timer <= 0 or (self.invulnerable_timer // 10) % 2 == 0:
            self.screen.blit(self.player.image, self.player.rect)
        
        # Draw HUD
        score_text = self.font_small.render(f"Score: {self.score}", True, GREEN)
        self.screen.blit(score_text, (10, 10))
        
        health_text = self.font_small.render(f"Health: {self.player.health}", True, RED)
        self.screen.blit(health_text, (SCREEN_WIDTH - 250, 10))
        
        time_text = self.font_small.render(f"Time: {self.time_elapsed:.1f}s", True, CYAN)
        self.screen.blit(time_text, (SCREEN_WIDTH // 2 - time_text.get_width() // 2, 10))
    
    def draw_game_over(self):
        """Draw game over screen"""
        game_over = self.font_large.render("GAME OVER", True, RED)
        final_score = self.font_medium.render(f"Final Score: {self.score}", True, YELLOW)
        time_text = self.font_medium.render(f"Time Survived: {self.time_elapsed:.1f}s", True, CYAN)
        
        is_new_high_score = self.score == self.high_score and self.score > 0
        if is_new_high_score:
            high_score_text = self.font_medium.render("NEW HIGH SCORE!", True, GREEN)
        else:
            high_score_text = self.font_small.render(f"High Score: {self.high_score}", True, WHITE)
        
        restart = self.font_small.render("Press SPACE to return to menu or Q to quit", True, WHITE)
        
        self.screen.blit(game_over, (SCREEN_WIDTH // 2 - game_over.get_width() // 2, 80))
        self.screen.blit(final_score, (SCREEN_WIDTH // 2 - final_score.get_width() // 2, 200))
        self.screen.blit(time_text, (SCREEN_WIDTH // 2 - time_text.get_width() // 2, 280))
        self.screen.blit(high_score_text, (SCREEN_WIDTH // 2 - high_score_text.get_width() // 2, 360))
        self.screen.blit(restart, (SCREEN_WIDTH // 2 - restart.get_width() // 2, 480))
    
    def run(self):
        """Main game loop"""
        running = True
        while running:
            running = self.handle_events()
            self.update()
            self.draw()
            pygame.display.flip()
            self.clock.tick(FPS)
        
        pygame.quit()


if __name__ == "__main__":
    game = Game()
    game.run()
